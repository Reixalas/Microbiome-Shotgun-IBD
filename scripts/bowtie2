#!/bin/bash

#SBATCH --job-name=bowtie2_R
#SBATCH --output=bowtie2_R.%j.out
#SBATCH --error=bowtie2_R.%j.err
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G

export LC_ALL=C

module load miniconda3
source ~/.bashrc
conda activate shotgun1

INPUT_DIR="/home/41701728z/trimmo"
OUTPUT_DIR="/home/41701728z/indexos"

mkdir -p "$OUTPUT_DIR"

for R1 in "$INPUT_DIR"/*_R1_paired.fastq.gz; do
    BASE=$(basename "${R1}" _R1_paired.fastq.gz)
    R2="$INPUT_DIR"/"$BASE"_R2_paired.fastq.gz
    
    echo "Processing sample: $BASE"


    bowtie2 -x "$OUTPUT_DIR"/GRCh38_index \
    -1 "$R1" \
    -2 "$R2" \
    --very-sensitive \
    -S "$OUTPUT_DIR"/"$BASE".sam \
    -p 4
    
    samtools view -uS "$OUTPUT_DIR"/"$BASE".sam | samtools sort -o "$OUTPUT_DIR"/"$BASE"_sorted.bam -
    
    samtools view -b -f 12 -F 256 "$OUTPUT_DIR"/"$BASE"_sorted.bam > "$OUTPUT_DIR"/"$BASE"_nonhuman.bam 

    samtools fastq \
    -1 "$OUTPUT_DIR"/"$BASE"_nonhuman_R1.fastq.gz \
    -2 "$OUTPUT_DIR"/"$BASE"_nonhuman_R2.fastq.gz \
    -0 /dev/null -s /dev/null -n \
    "$OUTPUT_DIR"/"$BASE"_nonhuman.bam 

    rm "$OUTPUT_DIR"/"$BASE".sam "$OUTPUT_DIR"/"$BASE"_sorted.bam "$OUTPUT_DIR"/"$BASE"_nonhuman.bam
done
